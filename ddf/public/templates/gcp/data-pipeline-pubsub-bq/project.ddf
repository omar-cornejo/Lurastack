Enables Requester Pays on a storage bucket.\n  rpo                         = \"\"     # string | optional+computed | Specifies the RPO setting of bucket. If set 'ASYNC_TURBO', T\u2026\n  storage_class               = \"\"     # string | optional | The Storage Class of the new bucket. Supported values includ\u2026\n  uniform_bucket_level_access = false  # bool | optional+computed | Enables uniform bucket-level access on a bucket.\n\n  # effective_labels            = {}     # map(string) | computed | All of labels (key/value pairs) present on the resource in G\u2026\n  # project_number              = 0      # number | computed | The project number of the project in which the resource belo\u2026\n  # self_link                   = \"\"     # string | computed | The URI of the created resource.\n  # terraform_labels            = {}     # map(string) | computed | The combination of labels configured directly on the resourc\u2026\n  # url                         = \"\"     # string | computed | The base URL of the bucket, in the format gs://<bucket-name>\u2026\n\n  autoclass { # list [0..1]\n    enabled                = false  # bool | required | While set to true, autoclass automatically transitions objec\u2026\n    terminal_storage_class = \"\"     # string | optional+computed | The storage class that objects in the bucket eventually tran\u2026\n\n  }\n\n  cors { # list\n    max_age_seconds = 0      # number | optional | The value, in seconds, to return in the Access-Control-Max-A\u2026\n    method          = []     # list(string) | optional | The list of HTTP methods on which to include CORS response h\u2026\n    origin          = []     # list(string) | optional | The list of Origins eligible to receive CORS response header\u2026\n    response_header = []     # list(string) | optional | The list of HTTP headers other than the simple response head\u2026\n\n  }\n\n  custom_placement_config { # list [0..1]\n    data_locations = []     # set(string) | required | The list o