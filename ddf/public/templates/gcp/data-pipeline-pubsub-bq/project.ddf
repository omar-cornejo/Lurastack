in the subscripti\u2026\n  project                      = \"\"     # string | optional+computed\n  retain_acked_messages        = false  # bool | optional | Indicates whether to retain acknowledged messages. If 'true'\u2026\n\n  # effective_labels             = {}     # map(string) | computed | All of labels (key/value pairs) present on the resource in G\u2026\n  # terraform_labels             = {}     # map(string) | computed | The combination of labels configured directly on the resourc\u2026\n\n  bigquery_config { # list [0..1]\n    table                 = \"\"     # string | required | The name of the table to which to write data, of the form {p\u2026\n    drop_unknown_fields   = false  # bool | optional | When true and use_topic_schema or use_table_schema is true, \u2026\n    service_account_email = \"\"     # string | optional | The service account to use to write to BigQuery. If not spec\u2026\n    use_table_schema      = false  # bool | optional | When true, use the BigQuery table's schema as the columns to\u2026\n    use_topic_schema      = false  # bool | optional | When true, use the topic's schema as the columns to write to\u2026\n    write_metadata        = false  # bool | optional | When true, write the subscription name, messageId, publishTi\u2026\n\n  }\n\n  cloud_storage_config { # list [0..1]\n    bucket                   = \"\"     # string | required | User-provided name for the Cloud Storage bucket. The bucket \u2026\n    filename_datetime_format = \"\"     # string | optional | User-provided format string specifying how to represent date\u2026\n    filename_prefix          = \"\"     # string | optional | User-provided prefix for Cloud Storage filename.\n    filename_suffix          = \"\"     # string | optional | User-provided suffix for Cloud Storage filename. Must not en\u2026\n    max_bytes                = 0      # number | optional | The maximum bytes that can be written to a Cloud Storage fil\u2026\n    max_duration             = \"\"  