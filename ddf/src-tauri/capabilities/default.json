{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "terminal-detached-*"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "opener:default",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    "fs:allow-appdata-write",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-read",
    "fs:allow-appdata-read-recursive",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-read-dir",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$HOME/**/.*" },
        { "path": "$HOME/**/.*/**" },
        { "path": "$APPDATA/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOCUMENT/**/.*" },
        { "path": "$DOCUMENT/**/.*/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DESKTOP/**/.*" },
        { "path": "$DESKTOP/**/.*/**" }
      ]
    }
  ]
}
