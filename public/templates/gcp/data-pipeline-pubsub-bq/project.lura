ma that messages published should be val…\n    encoding = \"\"     # string | optional | The encoding of messages validated against schema. Default v…\n\n  }\n\n  timeouts { # single\n    create = \"\"     # string | optional\n    delete = \"\"     # string | optional\n    update = \"\"     # string | optional\n\n  }\n\n}\n\n",
