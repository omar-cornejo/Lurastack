      "edges": [],
      "codeFiles": [
        {
          "id": "cf-startup",
          "name": "startup.sh",
          "content": "#!/bin/bash\nset -uo pipefail\n\napt-get update -y\napt-get install -y nginx\n\n# Each instance renders a distinct page (hostname + zone) so refreshing through\n# the load balancer visibly lands on a different backend.\nHOSTNAME=$(hostname)\nZONE=$(curl -s -H \"Metadata-Flavor: Google\" \"http://metadata.google.internal/computeMetadata/v1/instance/zone\" | awk -F/ '{print $NF}')\nHEX=$(echo -n \"$HOSTNAME\" | md5sum | cut -c1-6)\n\ncat > /var/www/html/index.html <<HTML\n<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <title>LuraStack — $HOSTNAME</title>\n    <style>\n      body { font-family: system-ui, sans-serif; display: grid; place-items: center; height: 100vh; margin: 0; background: #0f172a; color: #e2e8f0; }\n      .card { text-align: center; padding: 2rem 3rem; border: 4px solid #$HEX; border-radius: 12px; background: #1e293b; }\n      h1 { margin: 0 0 .5rem; color: #$HEX; }\n      code { color: #34d399; }\n    </style>\n  </head>\n  <body>\n    <div class=\"card\">\n      <h1>Instance $HOSTNAME</h1>\n      <p>Zone: <code>$ZONE</code></p>\n      <p>Refresh the page — the load balancer may route you to a different instance.</p>\n      <p>Served by <strong>LuraStack</strong> HTTP LB + Managed Instance Group.</p>\n    </div>\n  </body>\n</html>\nHTML\n\nsystemctl enable nginx\nsystemctl restart nginx\n"
        },
        {
          "id": "cf-var",
          "name": "variable.tf",
          "content": "variable \"project\" {\n  description = \"GCP project ID to deploy into\"\n  type        = string\n}\n"
        },
        {
          "id": "cf-output",
          "name": "output.tf",
          "content": "output \"lb_ip\" {\n  description = \"Public IP of the HTTP load balancer\"\n  value       = google_compute_global_forwarding_rule.app.ip_address\n}\n\noutput \"url\" {\n  description = \"Open this and refresh repeatedly to hit different instances\"\n  value       = \"http://${google_compute_global_forwarding_rule.app.ip_address}\"\n}\n"
        },
        {
          "id": "cf-tfvars",
          "name": "terraform.tfvars",
          "content": "# GCP project id.\n#\n# Leave this commented out to use the project from your saved GCP credentials\n# (LuraStack exports it as TF_VAR_project at deploy time).\n#\n# If you are not using LuraStack credentials, uncomment the next line and set it:\n# project = \"my-gcp-project-id\"\n"
        }
      ]
    }
  ]
}