  "views": [
    {
      "id": "view-gcp-web-0001",
      "name": "View 1",
      "activeProvider": "gcp",
      "resources": [
        {
          "id": "r-net",
          "kind": "resource",
          "type": "google_compute_network",
          "name": "main",
          "schemaId": "google_compute_network",
          "origin": "imported-file",
          "hclTemplate": "# resource: google_compute_network\nresource \"google_compute_network\" \"this\" {\n}\n",
          "config": {
            "attributes": {
              "name": "lurastack-web-vpc",
              "auto_create_subnetworks": false
            },
            "blocks": {}
          },
          "ui": {
            "x": 0,
            "y": 0,
            "icon": "/icons/gcp_networking.svg"
          }
        },
        {
          "id": "r-subnet",
          "kind": "resource",
          "type": "google_compute_subnetwork",
          "name": "main",
          "schemaId": "google_compute_subnetwork",
          "origin": "imported-file",
          "hclTemplate": "# resource: google_compute_subnetwork\nresource \"google_compute_subnetwork\" \"this\" {\n}\n",
          "config": {
            "attributes": {
              "name": "lurastack-web-subnet",
              "ip_cidr_range": "10.0.1.0/24",
              "region": "us-central1",
              "network": "google_compute_network.main.id"
            },
            "blocks": {}
          },
          "ui": {
            "x": 300,
            "y": 0,
            "icon": "/icons/gcp_networking.svg"
          }
        },
        {
          "id": "r-fw",
          "kind": "resource",
          "type": "google_compute_firewall",
          "name": "allow_http",
          "schemaId": "google_compute_firewall",
          "origin": "imported-file",
          "hclTemplate": "# resource: google_compute_firewall\nresource \"google_compute_firewall\" \"this\" {\n}\n",
          "config": {
            "attributes": {
              "name": "lurastack-web-allow-http",
              "network": "google_compute_network.main.id",
              "direction": "INGRESS",
              "source_ranges": "[\"0.0.0.0/0\", \"130.211.0.0/22\", \"35.191.0.0/16\"]",
              "target_tags": "[\"http-server\"]",
              "allow": [
                {
                  "protocol": "tcp",
                  "ports": "[\"80\"]"
                }
              ]
            },
            "blocks": {}
          },
          "ui": {
            "x": 600,
            "y": 0,
            "icon": "/icons/gcp_security_identity.svg"
          }
        },
        {
          "id": "r-hc",
          "kind": "resource",
          "type": "google_compute_health_check",
          "name": "http",
          "schemaId": "google_compute_health_check",
          "origin": "imported-file",
          "hclTemplate": "# resource: google_compute_health_check\nresource \"google_compute_health_check\" \"this\" {\n}\n",
          "config": {
            "attributes": {
              "name": "lurastack-web-hc",
              "check_interval_sec": 5,
              "timeout_sec": 5,
              "http_health_check": [
                {
                  "port": 80,
                  "request_path": "/"
                }
              ]
            },
            "blocks": {}
          },
          "ui": {
            "x": 900,
            "y": 0,
            "icon": "/icons/gcp_networking.svg"
          }
        },
        {
          "id": "r-tpl",
          "kind": "resource",
          "type": "google_compute_instance_template",
          "name": "app",
          "schemaId": "google_compute_instance_template",
          "origin": "imported-file",
          "hclTemplate": "# resource: google_compute_instance_template\nresource \"google_compute_instance_template\" \"this\" {\n}\n",
          "config": {
            "attributes": {
              "name_prefix": "lurastack-web-tpl-",
              "machine_type": "e2-small",
              "tags": "[\"http-server\"]",
              "disk": [
                {
                  "source_image": "debian-cloud/debian-12",
                  "auto_delete": true,
                  "boot": true
                }
              ],
              "network_interface": [
                {
                  "subnetwork": "google_compute_subnetwork.main.id",
                  "access_config": [
                    {}
                  ]
                }
              ],
              "metadata": "{ startup-script = file(\"${path.module}/startup.sh\") }"
            },
            "blocks": {}
          },
          "ui": {
            "x": 1200,
            "y": 0,
            "icon": "/icons/gcp_compute_engine.svg"
          }
        },
        {
          "id": "r-mig",
          "kind": "resource",
          "type": "google_compute_instance_group_manager",
          "name": "app",
          "schemaId": "google_compute_instance_group_manager",
          "origin": "imported-file",
          "hclTemplate": "# resource: google_compute_instance_group_manager\nresource \"google_compute_instance_group_manager\" \"this\" {\n}\n",
          "config": {
            "attributes": {
              "name": "lurastack-web-mig",
              "base_instance_name": "lurastack-web",
              "zone": "us-central1-a",
              "target_size": 3,
              "version": [
                {
                  "instance_template": "google_compute_instance_template.app.id"
                }
              ],
              "named_port": [
                {
                  "name": "http",
                  "port": 80
                }
              ]
            },
            "blocks": {}
          },
          "ui": {
            "x": 0,
            "y": 200,
            "icon": "/icons/gcp_compute_engine.svg"
          }
        },
        {
          "id": "r-backend",
          "kind": "resource",
          "type": "google_compute_backend_service",
          "name": "app",
          "schemaId": "google_compute_backend_service",
          "origin": "imported-file",
          "hclTemplate": "# resource: google_compute_backend_service\nresource \"google_compute_backend_service\" \"this\" {\n}\n",
          "config": {
            "attributes": {
              "name": "lurastack-web-backend",
              "protocol": "HTTP",
              "port_name": "http",
              "load_balancing_scheme": "EXTERNAL",
              "timeout_sec": 10,
              "health_checks": "[google_compute_health_check.http.id]",
              "backend": [
                {
                  "group": "google_compute_instance_group_manager.app.instance_group"
                }
              ]
            },
            "blocks": {}
          },
          "ui": {
            "x": 300,
            "y": 200,
            "icon": "/icons/gcp_networking.svg"
          }
        },
        {
          "id": "r-urlmap",
          "kind": "resource",
          "type": "google_compute_url_map",
          "name": "app",
          "schemaId": "google_compute_url_map",
          "origin": "imported-file",
          "hclTemplate": "# resource: google_compute_url_map\nresource \"google_compute_url_map\" \"this\" {\n}\n",
          "config": {
            "attributes": {
              "name": "lurastack-web-url-map",
              "default_service": "google_compute_backend_service.app.id"
            },
            "blocks": {}
          },
          "ui": {
            "x": 600,
            "y": 200,
            "icon": "/icons/gcp_networking.svg"
          }
        },
        {
          "id": "r-proxy",
          "kind": "resource",
          "type": "google_compute_target_http_proxy",
          "name": "app",
          "schemaId": "google_compute_target_http_proxy",
          "origin": "imported-file",
          "hclTemplate": "# resource: google_compute_target_http_proxy\nresource \"google_compute_target_http_proxy\" \"this\" {\n}\n",
          "config": {
            "attributes": {
              "name": "lurastack-web-proxy",
              "url_map": "google_compute_url_map.app.id"
            },
            "blocks": {}
          },
          "ui": {
            "x": 900,
            "y": 200,
            "icon": "/icons/gcp_networking.svg"
          }
        },
        {
          "id": "r-fr",
          "kind": "resource",
          "type": "google_compute_global_forwarding_rule",
          "name": "app",
          "schemaId": "google_compute_global_forwarding_rule",
          "origin": "imported-file",
          "hclTemplate": "# resource: google_compute_global_forwarding_rule\nresource \"google_compute_global_forwarding_rule\" \"this\" {\n}\n",
          "config": {
            "attributes": {
              "name": "lurastack-web-fr",
              "target": "google_compute_target_http_proxy.app.id",
              "port_range": "80",
              "load_balancing_scheme": "EXTERNAL"
            },
            "blocks": {}
          },
          "ui": {
            "x": 1200,
            "y": 200,
            "icon": "/icons/gcp_networking.svg"
          }
        }
