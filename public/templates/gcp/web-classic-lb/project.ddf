rt name as defined in InstanceGroup#NamedPort#name. If bot\u2026\n    port_specification = \"\"     # string | optional | Specifies how port is selected for health checking, can be o\u2026\n    proxy_header       = \"\"     # string | optional | Specifies the type of proxy header to append before sending \u2026\n    request_path       = \"\"     # string | optional | The request path of the HTTP health check request. The defau\u2026\n    response           = \"\"     # string | optional | The bytes to match against the beginning of the response dat\u2026\n\n  }\n\n  https_health_check { # list [0..1]\n    host               = \"\"     # string | optional | The value of the host header in the HTTPS health check reque\u2026\n    port               = 0      # number | optional | The TCP port number for the HTTPS health check request. The \u2026\n    port_name          = \"\"     # string | optional | Port name as defined in InstanceGroup#NamedPort#name. If bot\u2026\n    port_specification = \"\"     # string | optional | Specifies how port is selected for health checking, can be o\u2026\n    proxy_header       = \"\"     # string | optional | Specifies the type of proxy header to append before sending \u2026\n    request_path       = \"\"     # string | optional | The request path of the HTTPS health check request. The defa\u2026\n    response           = \"\"     # string | optional | The bytes to match against the beginning of the response dat\u2026\n\n  }\n\n  log_config { # list [0..1]\n    enable = false  # bool | optional | Indicates whether or not to export logs. This is false by de\u2026\n\n  }\n\n  ssl_health_check { # list [0..1]\n    port               = 0      # number | optional | The TCP port number for the SSL health check request. The de\u2026\n    port_name          = \"\"     # string | optional | Port name as defined in InstanceGroup#NamedPort#name. If bot\u2026\n    port_specification = \"\"     # string | optional | Specifies how port is selected for health checking, can be o\u2026\n    proxy_header       = \"\"     # string | optional | Specifies the type of proxy header to append before sending \u2026\n    request            = \"\"     # string | optional | The application data to send once the SSL connection has bee\u2026\n    response           = \"\"     # string | optional | The bytes to match against the beginning of the response dat\u2026\n\n  }\n\n  tcp_health_check { # list [0..1]\n    port               = 0      # number | optional | The TCP port number for the TCP health check request. The de\u2026\n    port_name          = \"\"     # string | optional | Port name as defined in InstanceGroup#NamedPort#name. If bot\u2026\n    port_specification = \"\"     # string | optional | Specifies how port is selected for health checking, can be o\u2026\n    proxy_header       = \"\"     # string | optional | Specifies the type of proxy header to append before sending \u2026\n    request            = \"\"     # string | optional | The application data to send once the TCP connection has bee\u2026\n    response           = \"\"     # string | optional | The bytes to match against the beginning of the response dat\u2026\n\n  }\n\n  timeouts { # single\n    create = \"\"     # string | optional\n    delete = \"\"     # string | optional\n    update = \"\"     # string | optional\n\n  }\n\n}\n\n",
