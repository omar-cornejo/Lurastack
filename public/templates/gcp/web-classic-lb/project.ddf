          "origin": "imported-file",
          "hclTemplate": "# \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n# \u2502  resource: google_compute_instance_template                    \u2502\n# \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\nresource \"google_compute_instance_template\" \"this\" {\n\n  machine_type            = \"\"     # string | required | The machine type to create. To create a machine with a custo\u2026\n  can_ip_forward          = false  # bool | optional | Whether to allow sending and receiving of packets with non-m\u2026\n  description             = \"\"     # string | optional | A brief description of this resource.\n  id                      = \"\"     # string | optional+computed\n  instance_description    = \"\"     # string | optional | A description of the instance.\n  labels                  = {}     # map(string) | optional | A set of key/value label pairs to assign to instances create\u2026\n  metadata                = {}     # map(string) | optional | Metadata key/value pairs to make available from within insta\u2026\n  metadata_startup_script = \"\"     # string | optional | An alternative to using the startup-script metadata key, mos\u2026\n  min_cpu_platform        = \"\"     # string | optional | Specifies a minimum CPU platform. Applicable values are the \u2026\n  name                    = \"\"     # string | optional+computed | The name of the instance template. If you leave this blank, \u2026\n  name_prefix             = \"\"     # string | optional+computed | Creates a unique name beginning with the specified prefix. C\u2026\n  project                 = \"\"     # string | optional+computed | The ID of the project in which the resource belongs. If it i\u2026\n  region                  = \"\"     # string | optional+computed | An instance template is a global resource that is not bound \u2026\n  resource_manager_tags   = {}     # map(string) | optional | A map of resource manager tags. \t\t\t\tResource manager tag key\u2026\n  resource_policies       = []     # list(string) | optional | A list of self_links of resource policies to attach to the i\u2026\n  tags                    = []     # set(string) | optional | Tags to attach to the instance.\n\n  # effective_labels        = {}     # map(string) | computed | All of labels (key/value pairs) present on the resource in G\u2026\n  # metadata_fingerprint    = \"\"     # string | computed | The unique fingerprint of the metadata.\n  # self_link               = \"\"     # string | computed | The URI of the created resource.\n  # self_link_unique        = \"\"     # string | computed | A special URI of the created resource that uniquely identifi\u2026\n  # tags_fingerprint        = \"\"     # string | computed | The unique fingerprint of the tags.\n  # terraform_labels        = {}     # map(string) | computed | The combination of labels configured directly on the resourc\u2026\n\n  advanced_machine_features { # list [0..1]\n    enable_nested_virtualization = false  # bool | optional | Whether to enable nested virtualization or not.\n    threads_per_core             = 0      # number | optional | The number of threads per physical core. To disable simultan\u2026\n    visible_core_count           = 0      # number | optional | The number of physical cores to expose to an instance. Multi\u2026\n\n  }\n\n  confidential_instance_config { # list [0..1]\n    confidential_instance_type  = \"\"     # string | optional |  \t\t\t\t\t\t\t\tThe confidential computing technology the instance \u2026\n    enable_confidential_compute = false  # bool | optional | Defines whether the instance should have confidential comput\u2026\n\n  }\n\n  disk { # list [1..*]\n    auto_delete           = false  # bool | optional | Whether or not the disk should be auto-deleted. This default\u2026\n    boot                  = false  # bool | optional+computed | Indicates that this is a boot disk.\n    device_name           = \"\"     # string | optional+computed | A unique device name that is reflected into the /dev/ tree o\u2026\n    disk_name             = \"\"     # string | optional | Name of the disk. When not provided, this defaults to the na\u2026\n    disk_size_gb          = 0      # number | optional+computed | The size of the image in gigabytes. If not specified, it wil\u2026\n    disk_type             = \"\"     # string | optional+computed | The Google Compute Engine disk type. Such as \"pd-ssd\", \"loca\u2026\n    interface             = \"\"     # string | optional+computed | Specifies the disk interface to use for attaching this disk.\n    labels                = {}     # map(string) | optional | A set of key/value label pairs to assign to disks,\n    mode                  = \"\"     # string | optional+computed | The mode in which to attach this disk, either READ_WRITE or \u2026\n    provisioned_iops      = 0      # number | optional+computed | Indicates how many IOPS to provision for the disk. This sets\u2026\n    resource_manager_tags = {}     # map(string) | optional | A map of resource manager tags. Resource manager tag keys an\u2026\n    resource_policies     = []     # list(string) | optional | A list (short name or id) of resource policies to attach to \u2026\n    source                = \"\"     # string | optional | The name (not self_link) of the disk (such as those managed \u2026\n    source_image          = \"\"     # string | optional+computed | The image from which to initialize this disk. This can be on\u2026\n    source_snapshot       = \"\"     # string | optional | The source snapshot to create this disk. When creating a new\u2026\n    type                  = \"\"     # string | optional+computed | The type of Google Compute Engine disk, can be either \"SCRAT\u2026\n\n    disk_encryption_key { # list [0..1]\n      kms_key_self_link = \"\"     # string | required | The self link of the encryption key that is stored in Google\u2026\n\n    }\n\n    source_image_encryption_key { # list [0..1]\n      kms_key_self_link       = \"\"     # string | required | The self link of the encryption key that is stored in Google\u2026\n      kms_key_service_account = \"\"     # string | optional | The service account being used for the encryption request fo\u2026\n\n    }\n\n    source_snapshot_encryption_key { # list [0..1]\n      kms_key_self_link       = \"\"     # string | required | The self link of the encryption key that is stored in Google\u2026\n      kms_key_service_account = \"\"     # string | optional | The service account being used for the encryption request fo\u2026\n\n    }\n\n  }\n\n  guest_accelerator { # list\n    count = 0      # number | required | The number of the guest accelerator cards exposed to this in\u2026\n    type  = \"\"     # string | required | The accelerator type resource to expose to this instance. E.\u2026\n\n  }\n\n  network_interface { # list\n    internal_ipv6_prefix_length = 0      # number | optional+computed | The prefix length of the primary internal IPv6 range.\n    ipv6_address                = \"\"     # string | optional+computed | An IPv6 internal network address for this network interface.\u2026\n    network                     = \"\"     # string | optional+computed | The name or self_link of the network to attach this interfac\u2026\n    network_ip                  = \"\"     # string | optional | The private IP address to assign to the instance. If empty, \u2026\n    nic_type                    = \"\"     # string | optional | The type of vNIC to be used on this interface. Possible valu\u2026\n    queue_count                 = 0      # number | optional | The networking queue count that's specified by users for the\u2026\n    stack_type                  = \"\"     # string | optional+computed | The stack type for this network interface to identify whethe\u2026\n    subnetwork                  = \"\"     # string | optional+computed | The name of the subnetwork to attach this interface to. The \u2026\n    subnetwork_project          = \"\"     # string | optional+computed | The ID of the project in which the subnetwork belongs. If it\u2026\n\n    # ipv6_access_type            = \"\"     # string | computed | One of EXTERNAL, INTERNAL to indicate whether the IP can be \u2026\n    # name                        = \"\"     # string | computed | The name of the network_interface.\n\n    access_config { # list\n      nat_ip                 = \"\"     # string | optional+computed | The IP address that will be 1:1 mapped to the instance's net\u2026\n      network_tier           = \"\"     # string | optional+computed | The networking tier used for configuring this instance templ\u2026\n\n      # public_ptr_domain_name = \"\"     # string | computed | The DNS domain name for the public PTR record.The DNS domain\u2026\n\n    }\n\n    alias_ip_range { # list\n      ip_cidr_range         = \"\"     # string | required | The IP CIDR range represented by this alias IP range. This I\u2026\n      subnetwork_range_name = \"\"     # string | optional | The subnetwork secondary range name specifying the secondary\u2026\n\n    }\n\n    ipv6_access_config { # list\n      network_tier                = \"\"     # string | required | The service-level to be provided for IPv6 traffic when the s\u2026\n\n      # external_ipv6               = \"\"     # string | computed | The first IPv6 address of the external IPv6 range associated\u2026\n      # external_ipv6_prefix_length = \"\"     # string | computed | The prefix length of the external IPv6 range.\n      # name                        = \"\"     # string | computed | The name of this access configuration.\n      # public_ptr_domain_name      = \"\"     # string | computed | The domain name to be used when creating DNSv6 records for t\u2026\n\n    }\n\n  }\n\n  network_performance_config { # list [0..1]\n    total_egress_bandwidth_tier = \"\"     # string | required | The egress bandwidth tier to enable. Possible values:TIER_1,\u2026\n\n  }\n\n  reservation_affinity { # list [0..1]\n    type = \"\"     # string | required | The type of reservation from which this instance can consume\u2026\n\n    specific_reservation { # list [0..1]\n      key    = \"\"     # string | required | Corresponds to the label key of a reservation resource. To t\u2026\n      values = []     # list(string) | required | Corresponds to the label values of a reservation resource.\n\n    }\n\n  }\n\n  scheduling { # list [0..1]\n    automatic_restart           = false  # bool | optional | Specifies whether the instance should be automatically resta\u2026\n    instance_termination_action = \"\"     # string | optional | Specifies the action GCE should take when SPOT VM is preempt\u2026\n    min_node_cpus               = 0      # number | optional | Minimum number of cpus for the instance.\n    on_host_maintenance         = \"\"     # string | optional+computed | Defines the maintenance behavior for this instance.\n    preemptible                 = false  # bool | optional | Allows instance to be preempted. This defaults to false.\n    provisioning_model          = \"\"     # string | optional+computed | Whether the instance is spot. If this is set as SPOT.\n\n    local_ssd_recovery_timeout { # list\n      seconds = 0      # number | required | Span of time at a resolution of a second. Must be from 0 to \u2026\n      nanos   = 0      # number | optional | Span of time that's a fraction of a second at nanosecond res\u2026\n\n    }\n\n    max_run_duration { # list [0..1]\n      seconds = 0      # number | required | Span of time at a resolution of a second. Must be from 0 to \u2026\n      nanos   = 0      # number | optional | Span of time that's a fraction of a second at nanosecond res\u2026\n\n    }\n\n    node_affinities { # set\n      key      = \"\"     # string | required\n      operator = \"\"     # string | required\n      values   = []     # set(string) | required\n\n    }\n\n    on_instance_stop_action { # list [0..1]\n      discard_local_ssd = false  # bool | optional | If true, the contents of any attached Local SSD disks will b\u2026\n\n    }\n\n  }\n\n  service_account { # list [0..1]\n    scopes = []     # set(string) | required | A list of service scopes. Both OAuth2 URLs and gcloud short \u2026\n    email  = \"\"     # string | optional+computed | The service account e-mail address. If not given, the defaul\u2026\n\n  }\n\n  shielded_instance_config { # list [0..1]\n    enable_integrity_monitoring = false  # bool | optional | Compare the most recent boot measurements to the integrity p\u2026\n    enable_secure_boot          = false  # bool | optional | Verify the digital signature of all boot components, and hal\u2026\n    enable_vtpm                 = false  # bool | optional | Use a virtualized trusted platform module, which is a specia\u2026\n\n  }\n\n  timeouts { # single\n    create = \"\"     # string | optional\n    delete = \"\"     # string | optional\n\n  }\n\n}\n\n",
