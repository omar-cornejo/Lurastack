          "hclTemplate": "# \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n# \u2502  resource: google_compute_firewall                             \u2502\n# \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\nresource \"google_compute_firewall\" \"this\" {\n\n  name                    = \"\"     # string | required | Name of the resource. Provided by the client when the resour\u2026\n  network                 = \"\"     # string | required | The name or self_link of the network to attach this firewall\u2026\n  description             = \"\"     # string | optional | An optional description of this resource. Provide this prope\u2026\n  destination_ranges      = []     # set(string) | optional+computed | If destination ranges are specified, the firewall will apply\u2026\n  direction               = \"\"     # string | optional+computed | Direction of traffic to which this firewall applies; default\u2026\n  disabled                = false  # bool | optional | Denotes whether the firewall rule is disabled, i.e not appli\u2026\n  enable_logging          = false  # bool | optional+computed+DEPRECATED | This field denotes whether to enable logging for a particula\u2026\n  id                      = \"\"     # string | optional+computed\n  priority                = 0      # number | optional | Priority for this rule. This is an integer between 0 and 655\u2026\n  project                 = \"\"     # string | optional+computed\n  source_ranges           = []     # set(string) | optional | If source ranges are specified, the firewall will apply only\u2026\n  source_service_accounts = []     # set(string) | optional | If source service accounts are specified, the firewall will \u2026\n  source_tags             = []     # set(string) | optional | If source tags are specified, the firewall will apply only t\u2026\n  target_service_accounts = []     # set(string) | optional | A list of service accounts indicating sets of instances loca\u2026\n  target_tags             = []     # set(string) | optional | A list of instance tags indicating sets of instances located\u2026\n\n  # creation_timestamp      = \"\"     # string | computed | Creation timestamp in RFC3339 text format.\n  # self_link               = \"\"     # string | computed\n\n  allow { # set\n    protocol = \"\"     # string | required | The IP protocol to which this rule applies. The protocol typ\u2026\n    ports    = []     # list(string) | optional | An optional list of ports to which this rule applies. This f\u2026\n\n  }\n\n  deny { # set\n    protocol = \"\"     # string | required | The IP protocol to which this rule applies. The protocol typ\u2026\n    ports    = []     # list(string) | optional | An optional list of ports to which this rule applies. This f\u2026\n\n  }\n\n  log_config { # list [0..1]\n    metadata = \"\"     # string | required | This field denotes whether to include or exclude metadata fo\u2026\n\n  }\n\n  timeouts { # single\n    create = \"\"     # string | optional\n    delete = \"\"     # string | optional\n    update = \"\"     # string | optional\n\n  }\n\n}\n\n",
