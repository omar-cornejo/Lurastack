nable_cdn                      = false  # bool | optional | If true, enable Cloud CDN for this BackendService.\n  health_checks                   = []     # set(string) | optional | The set of URLs to the HttpHealthCheck or HttpsHealthCheck r\u2026\n  id                              = \"\"     # string | optional+computed\n  load_balancing_scheme           = \"\"     # string | optional | Indicates whether the backend service will be used with inte\u2026\n  locality_lb_policy              = \"\"     # string | optional | The load balancing algorithm used within the scope of the lo\u2026\n  port_name                       = \"\"     # string | optional+computed | Name of backend port. The same name should appear in the ins\u2026\n  project                         = \"\"     # string | optional+computed\n  protocol                        = \"\"     # string | optional+computed | The protocol this BackendService uses to communicate with ba\u2026\n  security_policy                 = \"\"     # string | optional | The security policy associated with this backend service.\n  service_lb_policy               = \"\"     # string | optional | URL to networkservices.ServiceLbPolicy resource. Can only be\u2026\n  session_affinity                = \"\"     # string | optional+computed | Type of session affinity to use. The default is NONE. Sessio\u2026\n  timeout_sec                     = 0      # number | optional+computed | The backend service timeout has a different meaning dependin\u2026\n\n  # creation_timestamp              = \"\"     # string | computed | Creation timestamp in RFC3339 text format.\n  # fingerprint                     = \"\"     # string | computed | Fingerprint of this resource. A hash of the contents stored \u2026\n  # generated_id                    = 0      # number | computed | The unique identifier for the resource. This identifier is d\u2026\n  # self_link                       = \"\"     # string | computed\n\n  backend { # set\n    group          