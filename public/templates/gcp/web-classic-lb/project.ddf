| The maximum number of connections to the backend cluster. De\u2026\n    max_pending_requests        = 0      # number | optional | The maximum number of pending requests to the backend cluste\u2026\n    max_requests                = 0      # number | optional | The maximum number of parallel requests to the backend clust\u2026\n    max_requests_per_connection = 0      # number | optional | Maximum requests for a single backend connection. This param\u2026\n    max_retries                 = 0      # number | optional | The maximum number of parallel retries to the backend cluste\u2026\n\n  }\n\n  consistent_hash { # list [0..1]\n    http_header_name  = \"\"     # string | optional | The hash based on the value of the specified header field. T\u2026\n    minimum_ring_size = 0      # number | optional | The minimum number of virtual nodes to use for the hash ring\u2026\n\n    http_cookie { # list [0..1]\n      name = \"\"     # string | optional | Name of the cookie.\n      path = \"\"     # string | optional | Path to set for the cookie.\n\n      ttl { # list [0..1]\n        seconds = 0      # number | required | Span of time at a resolution of a second. Must be from 0 to \u2026\n        nanos   = 0      # number | optional | Span of time that's a fraction of a second at nanosecond res\u2026\n\n      }\n\n    }\n\n  }\n\n  iap { # list [0..1]\n    oauth2_client_id            = \"\"     # string | required | OAuth2 Client ID for IAP\n    oauth2_client_secret        = \"\"     # string | required+sensitive | OAuth2 Client Secret for IAP\n\n    # oauth2_client_secret_sha256 = \"\"     # string | computed+sensitive | OAuth2 Client Secret SHA-256 for IAP\n\n  }\n\n  locality_lb_policies { # list\n\n    custom_policy { # list [0..1]\n      name = \"\"     # string | required | Identifies the custom policy.  The value should match the ty\u2026\n      data = \"\"     # string | optional | An optional, arbitrary JSON object with configuration data, \u2026\n\n    }\n\n    pol