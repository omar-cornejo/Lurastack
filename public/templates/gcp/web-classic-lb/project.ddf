ccess       = \"\"     # string | optional+computed | The private IPv6 google access type for the VMs in this subn\u2026\n  project                          = \"\"     # string | optional+computed\n  purpose                          = \"\"     # string | optional+computed | The purpose of the resource. This field can be either 'PRIVA\u2026\n  region                           = \"\"     # string | optional+computed | The GCP region for this subnetwork.\n  role                             = \"\"     # string | optional | The role of subnetwork. Currently, this field is only used w\u2026\n  secondary_ip_range               = []     # list(object({ ip_cidr_range: string, range_name: string })) | optional+computed | An array of configurations for secondary IP ranges for VM in\u2026\n  send_secondary_ip_range_if_empty = false  # bool | optional | Controls the removal behavior of secondary_ip_range. When fa\u2026\n  stack_type                       = \"\"     # string | optional+computed | The stack type for this subnet to identify whether the IPv6 \u2026\n\n  # creation_timestamp               = \"\"     # string | computed | Creation timestamp in RFC3339 text format.\n  # fingerprint                      = \"\"     # string | computed+DEPRECATED | Fingerprint of this resource. This field is used internally \u2026\n  # gateway_address                  = \"\"     # string | computed | The gateway address for default routes to reach destination \u2026\n  # internal_ipv6_prefix             = \"\"     # string | computed | The internal IPv6 address range that is assigned to this sub\u2026\n  # ipv6_cidr_range                  = \"\"     # string | computed | The range of internal IPv6 addresses that are owned by this \u2026\n  # self_link                        = \"\"     # string | computed\n\n  log_config { # list [0..1]\n    aggregation_interval = \"\"     # string | optional | Can only be specified if VPC flow logging for this subnetwor\u2026\n    filter_expr          = \"\"     # string | optional | Export filter used to define which VPC flow logs should be l\u2026\n    flow_sampling        = 0      # number | optional | Can only be specified if VPC flow logging for this subnetwor\u2026\n    metadata             = \"\"     # string | optional | Can only be specified if VPC flow logging for this subnetwor\u2026\n    metadata_fields      = []     # set(string) | optional | List of metadata fields that should be added to reported log\u2026\n\n  }\n\n  timeouts { # single\n    create = \"\"     # string | optional\n    delete = \"\"     # string | optional\n    update = \"\"     # string | optional\n\n  }\n\n}\n\n",
