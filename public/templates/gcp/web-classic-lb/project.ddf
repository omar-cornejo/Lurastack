optional+computed | The networking tier used for configuring this address. If th\u2026\n  prefix_length      = 0      # number | optional+computed | The prefix length if the resource represents an IP range.\n  project            = \"\"     # string | optional+computed\n  purpose            = \"\"     # string | optional+computed | The purpose of this resource, which can be one of the follow\u2026\n  region             = \"\"     # string | optional+computed | The Region in which the created address should reside. If it\u2026\n  subnetwork         = \"\"     # string | optional+computed | The URL of the subnetwork in which to reserve the address. I\u2026\n\n  # creation_timestamp = \"\"     # string | computed | Creation timestamp in RFC3339 text format.\n  # effective_labels   = {}     # map(string) | computed | All of labels (key/value pairs) present on the resource in G\u2026\n  # label_fingerprint  = \"\"     # string | computed | The fingerprint used for optimistic locking of this resource\u2026\n  # self_link          = \"\"     # string | computed\n  # terraform_labels   = {}     # map(string) | computed | The combination of labels configured directly on the resourc\u2026\n  # users              = []     # list(string) | computed | The URLs of the resources that are using this address.\n\n  timeouts { # single\n    create = \"\"     # string | optional\n    delete = \"\"     # string | optional\n    update = \"\"     # string | optional\n\n  }\n\n}\n\n",
