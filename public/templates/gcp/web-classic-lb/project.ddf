tes. The default value is 146\u2026\n  network_firewall_policy_enforcement_order = \"\"     # string | optional | Set the order that Firewall Rules and Firewall Policies are \u2026\n  project                                   = \"\"     # string | optional+computed\n  routing_mode                              = \"\"     # string | optional+computed | The network-wide routing mode to use. If set to 'REGIONAL', \u2026\n\n  # gateway_ipv4                              = \"\"     # string | computed | The gateway address for default routing out of the network. \u2026\n  # numeric_id                                = \"\"     # string | computed | The unique identifier for the resource. This identifier is d\u2026\n  # self_link                                 = \"\"     # string | computed\n\n  timeouts { # single\n    create = \"\"     # string | optional\n    delete = \"\"     # string | optional\n    update = \"\"     # string | optional\n\n  }\n\n}\n\n",
