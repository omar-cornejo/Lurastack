      "codeFiles": [
        {
          "id": "cf-index",
          "name": "index.js",
          "content": "// Cat gallery backend — a single Cloud Function (2nd gen, HTTP trigger).\n//\n//   GET  /   -> { photos: [\"cats/cat1.jpg\", ...] }   lists objects under cats/\n//   POST /   -> { key }   receives an image (base64 JSON) and stores it in GCS\n//\n// The bucket name is injected via the BUCKET env var by Terraform. CORS headers\n// are set so the static page (served from the same bucket) can call the function.\nconst { Storage } = require(\"@google-cloud/storage\");\n\nconst storage = new Storage();\nconst BUCKET = process.env.BUCKET;\nconst PREFIX = \"cats/\";\n\nfunction cors(res) {\n  res.set(\"Access-Control-Allow-Origin\", \"*\");\n  res.set(\"Access-Control-Allow-Methods\", \"GET, POST, OPTIONS\");\n  res.set(\"Access-Control-Allow-Headers\", \"content-type\");\n}\n\nexports.handler = async (req, res) => {\n  cors(res);\n  if (req.method === \"OPTIONS\") {\n    res.status(204).send(\"\");\n    return;\n  }\n\n  const bucket = storage.bucket(BUCKET);\n\n  if (req.method === \"GET\") {\n    const [files] = await bucket.getFiles({ prefix: PREFIX });\n    const photos = files.map((f) => f.name).filter((n) => n && n !== PREFIX);\n    res.status(200).json({ photos });\n    return;\n  }\n\n  if (req.method === \"POST\") {\n    const body = req.body || {};\n    const data = body.data;\n    if (!data) {\n      res.status(400).json({ error: \"missing 'data' (base64 image)\" });\n      return;\n    }\n    const contentType = body.contentType || \"image/jpeg\";\n    const ext = (contentType.split(\"/\")[1] || \"jpg\").replace(/[^a-z0-9]/gi, \"\");\n    const key = `${PREFIX}upload-${Date.now()}.${ext}`;\n    await bucket.file(key).save(Buffer.from(data, \"base64\"), { contentType });\n    res.status(200).json({ key });\n    return;\n  }\n\n  res.status(405).json({ error: \"method not allowed\" });\n};\n"
        },
        {
          "id": "cf-pkg",
          "name": "package.json",
          "content": "{\n  \"name\": \"lurastack-cat-gallery\",\n  \"version\": \"1.0.0\",\n  \"main\": \"index.js\",\n  \"dependencies\": {\n    \"@google-cloud/functions-framework\": \"^3.4.0\",\n    \"@google-cloud/storage\": \"^7.7.0\"\n  }\n}\n"
        },
        {
          "id": "cf-html",
          "name": "index.html.tpl",
          "content": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>LuraStack — Cat Gallery 🐱 (GCP)</title>\n    <style>\n      :root { color-scheme: dark; }\n      body { font-family: system-ui, sans-serif; margin: 0; background: #0f172a; color: #e2e8f0; }\n      header { padding: 2rem 1rem 1rem; text-align: center; }\n      h1 { margin: 0 0 .25rem; }\n      .muted { color: #94a3b8; font-size: .9rem; }\n      .bar { display: flex; gap: .75rem; justify-content: center; align-items: center; padding: 1rem; flex-wrap: wrap; }\n      button, label.btn { background: #34d399; color: #0f172a; border: none; padding: .6rem 1.1rem; border-radius: 8px; font-weight: 600; cursor: pointer; }\n      #grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; padding: 1rem 1.5rem 3rem; max-width: 1100px; margin: 0 auto; }\n      .card { background: #1e293b; border: 1px solid #334155; border-radius: 12px; overflow: hidden; }\n      .card img { width: 100%; height: 170px; object-fit: cover; display: block; }\n      .card .name { padding: .5rem .75rem; font-size: .8rem; color: #94a3b8; word-break: break-all; }\n      #status { text-align: center; min-height: 1.2rem; color: #94a3b8; }\n    </style>\n  </head>\n  <body>\n    <header>\n      <h1>Cat Gallery 🐱</h1>\n      <p class=\"muted\">Served from Cloud Storage · uploads handled by a Cloud Function · provisioned with LuraStack</p>\n    </header>\n\n    <div class=\"bar\">\n      <label class=\"btn\">\n        Upload a cat\n        <input id=\"file\" type=\"file\" accept=\"image/*\" hidden />\n      </label>\n      <button id=\"refresh\">Refresh</button>\n    </div>\n    <p id=\"status\"></p>\n\n    <div id=\"grid\"></div>\n\n    <script>\n      // Injected by Terraform via templatefile().\n      const API = \"${api_url}\";\n      // Public GCS base for this bucket; photos are objects under it.\n      const BUCKET_URL = \"${bucket_url}\";\n      const photoUrl = (key) => BUCKET_URL + \"/\" + key;\n\n      const grid = document.getElementById(\"grid\");\n      const statusEl = document.getElementById(\"status\");\n\n      async function load() {\n        statusEl.textContent = \"Loading cats…\";\n        try {\n          const res = await fetch(API, { method: \"GET\" });\n          const { photos = [] } = await res.json();\n          grid.innerHTML = \"\";\n          if (!photos.length) { statusEl.textContent = \"No cats yet — upload one!\"; return; }\n          for (const key of photos) {\n            const card = document.createElement(\"div\");\n            card.className = \"card\";\n            card.innerHTML =\n              '<img src=\"' + photoUrl(key) + '\" alt=\"cat\" loading=\"lazy\" />' +\n              '<div class=\"name\">' + key.replace(\"cats/\", \"\") + \"</div>\";\n            grid.appendChild(card);\n          }\n          statusEl.textContent = photos.length + \" cat(s) 🐾\";\n        } catch (e) {\n          statusEl.textContent = \"Could not load photos: \" + e;\n        }\n      }\n\n      function toBase64(file) {\n        return new Promise((resolve, reject) => {\n          const reader = new FileReader();\n          reader.onload = () => resolve(String(reader.result).split(\",\")[1]);\n          reader.onerror = reject;\n          reader.readAsDataURL(file);\n        });\n      }\n\n      document.getElementById(\"file\").addEventListener(\"change\", async (ev) => {\n        const file = ev.target.files[0];\n        if (!file) return;\n        statusEl.textContent = \"Uploading \" + file.name + \"…\";\n        try {\n          const data = await toBase64(file);\n          await fetch(API, {\n            method: \"POST\",\n            headers: { \"content-type\": \"application/json\" },\n            body: JSON.stringify({ data, contentType: file.type || \"image/jpeg\" }),\n          });\n          setTimeout(load, 1200);\n        } catch (e) {\n          statusEl.textContent = \"Upload failed: \" + e;\n        }\n        ev.target.value = \"\";\n      });\n\n      document.getElementById(\"refresh\").addEventListener(\"click\", load);\n      load();\n    </script>\n  </body>\n</html>\n"
        },
        {
          "id": "cf-cat1",
          "name": "cat1.b64",
          "content": "\n"
        },
        {
          "id": "cf-cat2",
          "name": "cat2.b64",
          "content": "\n"
        },
        {
          "id": "cf-cat3",
          "name": "cat3.b64",
          "content": "\n"
        },
        {
          "id": "cf-var",
          "name": "variable.tf",
          "content": "variable \"project\" {\n  description = \"GCP project ID to deploy into\"\n  type        = string\n}\n"
        },
        {
          "id": "cf-output",
          "name": "output.tf",
          "content": "output \"website_url\" {\n  description = \"Open this in a browser to see the cat gallery\"\n  value       = \"https://storage.googleapis.com/${google_storage_bucket.gallery.name}/index.html\"\n}\n\noutput \"api_url\" {\n  description = \"Cloud Function URL used by the page to list and upload cats\"\n  value       = google_cloudfunctions2_function.api.url\n}\n\noutput \"bucket_name\" {\n  description = \"Name of the GCS bucket holding the gallery\"\n  value       = google_storage_bucket.gallery.name\n}\n"
        },
        {
          "id": "cf-tfvars",
          "name": "terraform.tfvars",
          "content": "# GCP project id.\n#\n# Leave this commented out to use the project from your saved GCP credentials\n# (LuraStack exports it as TF_VAR_project at deploy time).\n#\n# If you are not using LuraStack credentials, uncomment the next line and set it:\n# project = \"my-gcp-project-id\"\n"
        }
      ]
    }
  ]
}