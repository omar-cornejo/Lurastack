      "resources": [
        {
          "id": "r-random",
          "kind": "resource",
          "type": "random_id",
          "name": "suffix",
          "schemaId": "random_id",
          "origin": "imported-file",
          "hclTemplate": "# resource: random_id\nresource \"random_id\" \"this\" {\n}\n",
          "config": {
            "attributes": {
              "byte_length": 4
            },
            "blocks": {}
          },
          "ui": {
            "x": 0,
            "y": 0,
            "icon": "/icons/gcp_serverless.svg"
          }
        },
        {
          "id": "r-bucket",
          "kind": "resource",
          "type": "google_storage_bucket",
          "name": "gallery",
          "schemaId": "google_storage_bucket",
          "origin": "imported-file",
          "hclTemplate": "# resource: google_storage_bucket\nresource \"google_storage_bucket\" \"this\" {\n}\n",
          "config": {
            "attributes": {
              "name": "\"lurastack-cats-${random_id.suffix.hex}\"",
              "location": "US",
              "force_destroy": true,
              "uniform_bucket_level_access": true,
              "website": [
                {
                  "main_page_suffix": "index.html"
                }
              ]
            },
            "blocks": {}
          },
          "ui": {
            "x": 300,
            "y": 0,
            "icon": "/icons/gcp_cloud_storage.svg"
          }
        },
        {
          "id": "r-bucket-iam",
          "kind": "resource",
          "type": "google_storage_bucket_iam_member",
          "name": "public",
          "schemaId": "google_storage_bucket_iam_member",
          "origin": "imported-file",
          "hclTemplate": "# resource: google_storage_bucket_iam_member\nresource \"google_storage_bucket_iam_member\" \"this\" {\n}\n",
          "config": {
            "attributes": {
              "bucket": "google_storage_bucket.gallery.name",
              "role": "roles/storage.objectViewer",
              "member": "allUsers"
            },
            "blocks": {}
          },
          "ui": {
            "x": 600,
            "y": 0,
            "icon": "/icons/gcp_security_identity.svg"
          }
        },
        {
          "id": "r-src-bucket",
          "kind": "resource",
          "type": "google_storage_bucket",
          "name": "source",
          "schemaId": "google_storage_bucket",
          "origin": "imported-file",
          "hclTemplate": "# resource: google_storage_bucket\nresource \"google_storage_bucket\" \"this\" {\n}\n",
          "config": {
            "attributes": {
              "name": "\"lurastack-cats-src-${random_id.suffix.hex}\"",
              "location": "US",
              "force_destroy": true,
              "uniform_bucket_level_access": true
            },
            "blocks": {}
          },
          "ui": {
            "x": 900,
            "y": 0,
            "icon": "/icons/gcp_cloud_storage.svg"
          }
        },
        {
          "id": "d-archive",
          "kind": "data",
          "type": "archive_file",
          "name": "fn",
          "schemaId": "archive_file",
          "origin": "imported-file",
          "hclTemplate": "# data: archive_file\ndata \"archive_file\" \"this\" {\n}\n",
          "config": {
            "attributes": {
              "type": "zip",
              "output_path": "\"${path.module}/function.zip\"",
              "source": [
                {
                  "content": "file(\"${path.module}/index.js\")",
                  "filename": "index.js"
                },
                {
                  "content": "file(\"${path.module}/package.json\")",
                  "filename": "package.json"
                }
              ]
            },
            "blocks": {}
          },
          "ui": {
            "x": 1200,
            "y": 0,
            "icon": "/icons/gcp_serverless.svg"
          }
        },
        {
          "id": "r-src-obj",
          "kind": "resource",
          "type": "google_storage_bucket_object",
          "name": "fn",
          "schemaId": "google_storage_bucket_object",
          "origin": "imported-file",
          "hclTemplate": "# resource: google_storage_bucket_object\nresource \"google_storage_bucket_object\" \"this\" {\n}\n",
          "config": {
            "attributes": {
              "name": "\"function-${data.archive_file.fn.output_md5}.zip\"",
              "bucket": "google_storage_bucket.source.name",
              "source": "data.archive_file.fn.output_path"
            },
            "blocks": {}
          },
          "ui": {
            "x": 0,
            "y": 200,
            "icon": "/icons/gcp_cloud_storage.svg"
          }
        },
        {
          "id": "r-sa",
          "kind": "resource",
          "type": "google_service_account",
          "name": "fn",
          "schemaId": "google_service_account",
          "origin": "imported-file",
          "hclTemplate": "# resource: google_service_account\nresource \"google_service_account\" \"this\" {\n}\n",
          "config": {
            "attributes": {
              "account_id": "\"lurastack-cats-${random_id.suffix.hex}\"",
              "display_name": "LuraStack Cat Gallery function"
            },
            "blocks": {}
          },
          "ui": {
            "x": 300,
            "y": 200,
            "icon": "/icons/gcp_security_identity.svg"
          }
        },
        {
          "id": "r-sa-iam",
          "kind": "resource",
          "type": "google_storage_bucket_iam_member",
          "name": "fn",
          "schemaId": "google_storage_bucket_iam_member",
          "origin": "imported-file",
          "hclTemplate": "# resource: google_storage_bucket_iam_member\nresource \"google_storage_bucket_iam_member\" \"this\" {\n}\n",
          "config": {
            "attributes": {
              "bucket": "google_storage_bucket.gallery.name",
              "role": "roles/storage.objectAdmin",
              "member": "\"serviceAccount:${google_service_account.fn.email}\""
            },
            "blocks": {}
          },
          "ui": {
            "x": 600,
            "y": 200,
            "icon": "/icons/gcp_security_identity.svg"
          }
        },
        {
          "id": "r-fn",
          "kind": "resource",
          "type": "google_cloudfunctions2_function",
          "name": "api",
          "schemaId": "google_cloudfunctions2_function",
          "origin": "imported-file",
          "hclTemplate": "# resource: google_cloudfunctions2_function\nresource \"google_cloudfunctions2_function\" \"this\" {\n}\n",
          "config": {
            "attributes": {
              "name": "\"lurastack-cats-${random_id.suffix.hex}\"",
              "location": "us-central1",
              "build_config": [
                {
                  "runtime": "nodejs20",
                  "entry_point": "handler",
                  "source": [
                    {
                      "storage_source": [
                        {
                          "bucket": "google_storage_bucket.source.name",
                          "object": "google_storage_bucket_object.fn.name"
                        }
                      ]
                    }
                  ]
                }
              ],
              "service_config": [
                {
                  "max_instance_count": 3,
                  "available_memory": "256M",
                  "timeout_seconds": 60,
                  "service_account_email": "google_service_account.fn.email",
                  "environment_variables": "{ BUCKET = google_storage_bucket.gallery.name }"
                }
              ]
            },
            "blocks": {}
          },
          "ui": {
            "x": 900,
            "y": 200,
            "icon": "/icons/gcp_serverless.svg"
          }
        },
        {
          "id": "r-fn-iam",
          "kind": "resource",
          "type": "google_cloud_run_service_iam_member",
          "name": "public",
          "schemaId": "google_cloud_run_service_iam_member",
          "origin": "imported-file",
          "hclTemplate": "# resource: google_cloud_run_service_iam_member\nresource \"google_cloud_run_service_iam_member\" \"this\" {\n}\n",
          "config": {
            "attributes": {
              "location": "google_cloudfunctions2_function.api.location",
              "service": "google_cloudfunctions2_function.api.name",
              "role": "roles/run.invoker",
              "member": "allUsers"
            },
            "blocks": {}
          },
          "ui": {
            "x": 1200,
            "y": 200,
            "icon": "/icons/gcp_security_identity.svg"
          }
        },
        {
          "id": "r-obj-index",
          "kind": "resource",
          "type": "google_storage_bucket_object",
          "name": "index",
          "schemaId": "google_storage_bucket_object",
          "origin": "imported-file",
          "hclTemplate": "# resource: google_storage_bucket_object\nresource \"google_storage_bucket_object\" \"this\" {\n}\n",
          "config": {
            "attributes": {
              "name": "index.html",
              "bucket": "google_storage_bucket.gallery.name",
              "content_type": "text/html",
              "content": "templatefile(\"${path.module}/index.html.tpl\", { api_url = google_cloudfunctions2_function.api.url, bucket_url = \"https://storage.googleapis.com/${google_storage_bucket.gallery.name}\" })"
            },
            "blocks": {}
          },
          "ui": {
            "x": 0,
            "y": 400,
            "icon": "/icons/gcp_cloud_storage.svg"
          }
        },
