          "kind": "resource",
          "type": "google_compute_instance",
          "name": "vm",
          "schemaId": "google_compute_instance",
          "origin": "imported-file",
          "hclTemplate": "# resource: google_compute_instance\nresource \"google_compute_instance\" \"this\" {\n}\n",
          "config": {
            "attributes": {
              "name": "lurastack-basic-vm",
              "machine_type": "e2-micro",
