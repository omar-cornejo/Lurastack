      "edges": [],
      "codeFiles": [
        {
          "id": "cf-startup",
          "name": "startup.sh",
          "content": "#!/bin/bash\nset -uo pipefail\n\n# Debian/Ubuntu images on GCE use apt.\napt-get update -y\napt-get install -y nginx\n\ncat > /var/www/html/index.html <<'HTML'\n<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <title>LuraStack — nginx on GCE</title>\n    <style>\n      body { font-family: system-ui, sans-serif; display: grid; place-items: center; height: 100vh; margin: 0; background: #0f172a; color: #e2e8f0; }\n      .card { text-align: center; padding: 2rem 3rem; border: 1px solid #334155; border-radius: 12px; background: #1e293b; }\n      h1 { margin: 0 0 .5rem; }\n      code { color: #34d399; }\n    </style>\n  </head>\n  <body>\n    <div class=\"card\">\n      <h1>It works 🎉</h1>\n      <p>nginx is running on this Compute Engine VM, served on <code>port 80</code>.</p>\n      <p>Provisioned with <strong>LuraStack</strong>.</p>\n    </div>\n  </body>\n</html>\nHTML\n\nsystemctl enable nginx\nsystemctl restart nginx\n"
        },
        {
          "id": "cf-var",
          "name": "variable.tf",
          "content": "variable \"project\" {\n  description = \"GCP project ID to deploy into\"\n  type        = string\n}\n"
        },
        {
          "id": "cf-output",
          "name": "output.tf",
          "content": "output \"instance_public_ip\" {\n  description = \"Public IP of the nginx VM\"\n  value       = google_compute_instance.vm.network_interface[0].access_config[0].nat_ip\n}\n\noutput \"url\" {\n  description = \"Open this URL to see the nginx welcome page\"\n  value       = \"http://${google_compute_instance.vm.network_interface[0].access_config[0].nat_ip}\"\n}\n"
        },
        {
          "id": "cf-tfvars",
          "name": "terraform.tfvars",
          "content": "# GCP project id.\n#\n# Leave this commented out to use the project from your saved GCP credentials\n# (LuraStack exports it as TF_VAR_project at deploy time).\n#\n# If you are not using LuraStack credentials, uncomment the next line and set it:\n# project = \"my-gcp-project-id\"\n"
        }
      ]
    }
