ance tags indicating sets of instances located…\n\n  # creation_timestamp      = \"\"     # string | computed | Creation timestamp in RFC3339 text format.\n  # self_link               = \"\"     # string | computed\n\n  allow { # set\n    protocol = \"\"     # string | required | The IP protocol to which this rule applies. The protocol typ…\n    ports    = []     # list(string) | optional | An optional list of ports to which this rule applies. This f…\n\n  }\n\n  deny { # set\n    protocol = \"\"     # string | required | The IP protocol to which this rule applies. The protocol typ…\n    ports    = []     # list(string) | optional | An optional list of ports to which this rule applies. This f…\n\n  }\n\n  log_config { # list [0..1]\n    metadata = \"\"     # string | required | This field denotes whether to include or exclude metadata fo…\n\n  }\n\n  timeouts { # single\n    create = \"\"     # string | optional\n    delete = \"\"     # string | optional\n    update = \"\"     # string | optional\n\n  }\n\n}\n\n",
