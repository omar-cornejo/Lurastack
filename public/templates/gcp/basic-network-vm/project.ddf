          "origin": "imported-file",
          "hclTemplate": "# \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n# \u2502  resource: google_compute_network                              \u2502\n# \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\nresource \"google_compute_network\" \"this\" {\n\n  name                                      = \"\"     # string | required | Name of the resource. Provided by the client when the resour\u2026\n  auto_create_subnetworks                   = false  # bool | optional | When set to 'true', the network is created in \"auto subnet m\u2026\n  delete_default_routes_on_create           = false  # bool | optional | If set to 'true', default routes ('0.0.0.0/0') will be delet\u2026\n  description                               = \"\"     # string | optional | An optional description of this resource. The resource must \u2026\n  enable_ula_internal_ipv6                  = false  # bool | optional | Enable ULA internal ipv6 on this network. Enabling this feat\u2026\n  id                                        = \"\"     # string | optional+computed\n  internal_ipv6_range                       = \"\"     # string | optional+computed | When enabling ula internal ipv6, caller optionally can speci\u2026\n  mtu                                       = 0      # number | optional+computed | Maximum Transmission Unit in bytes. The default value is 146\u2026\n  network_firewall_policy_enforcement_order = \"\"     # string | optional | Set the order that Firewall Rules and Firewall Policies are \u2026\n  project                                   = \"\"     # string | optional+computed\n  routing_mode                              = \"\"     # string | optional+computed | The network-wide routing mode to use. If set to 'REGIONAL', \u2026\n\n  # gateway_ipv4                              = \"\"     # string | computed | The gateway address for default routing out of the network. \u2026\n  # numeric_id                                = \"\"     # string | computed | The unique identifier for the resource. This identifier is d\u2026\n  # self_link                                 = \"\"     # string | computed\n\n  timeouts { # single\n    create = \"\"     # string | optional\n    delete = \"\"     # string | optional\n    update = \"\"     # string | optional\n\n  }\n\n}\n\n",
