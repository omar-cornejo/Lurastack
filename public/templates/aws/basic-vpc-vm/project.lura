 # string | computed\n\n  }\n\n  timeouts { # single\n    create = \"\"     # string | optional\n    delete = \"\"     # string | optional\n    read   = \"\"     # string | optional\n    update = \"\"     # string | optional\n\n  }\n\n}\n\n",
