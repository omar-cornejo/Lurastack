        {
          "id": "7edf3fd3-6b72-4a81-91a8-acb531d67354",
          "kind": "resource",
          "type": "aws_security_group",
          "name": "web",
          "schemaId": "aws_security_group",
          "origin": "imported-file",
          "hclTemplate": "# ┌──────────────────────────────────────────────────────────────┐\n# │  resource: aws_security_group                                  │\n# └──────────────────────────────────────────────────────────────┘\nresource \"aws_security_group\" \"this\" {\n\n  description            = \"\"     # string | optional\n  egress                 = []     # set(object({ cidr_blocks: list(string), description: string, from_port: number, ipv6_cidr_blocks: list(string), prefix_list_ids: list(string), protocol: string, security_groups: set(string), self: bool, to_port: number })) | optional+computed\n  id                     = \"\"     # string | optional+computed\n  ingress                = []     # set(object({ cidr_blocks: list(string), description: string, from_port: number, ipv6_cidr_blocks: list(string), prefix_list_ids: list(string), protocol: string, security_groups: set(string), self: bool, to_port: number })) | optional+computed\n  name                   = \"\"     # string | optional+computed\n  name_prefix            = \"\"     # string | optional+computed\n  revoke_rules_on_delete = false  # bool | optional\n  tags                   = {}     # map(string) | optional\n  tags_all               = {}     # map(string) | optional+computed\n  vpc_id                 = \"\"     # string | optional+computed\n\n  # arn                    = \"\"     # string | computed\n  # owner_id               = \"\"     # string | computed\n\n  timeouts { # single\n    create = \"\"     # string | optional\n    delete = \"\"     # string | optional\n\n  }\n\n}\n\n",
          "config": {
            "attributes": {
              "name": "lurastack-basic-web",
              "vpc_id": "aws_vpc.main.id",
              "description": "Allow HTTP (80) and SSH (22)",
              "ingress": [
                {
                  "description": "HTTP",
                  "from_port": 80,
                  "to_port": 80,
                  "protocol": "tcp",
                  "cidr_blocks": "[\"0.0.0.0/0\"]"
                },
                {
                  "description": "SSH",
                  "from_port": 22,
                  "to_port": 22,
                  "protocol": "tcp",
                  "cidr_blocks": "[\"0.0.0.0/0\"]"
                }
              ],
              "egress": [
                {
                  "description": "All outbound",
                  "from_port": 0,
                  "to_port": 0,
                  "protocol": -1,
                  "cidr_blocks": "[\"0.0.0.0/0\"]"
                }
              ],
              "tags": "{ Name = \"lurastack-basic-web\" }"
            },
            "blocks": {}
          },
          "ui": {
            "x": 560,
            "y": 200,
            "icon": "/icons/aws_security_group.svg"
