          "origin": "imported-file",
          "hclTemplate": "# ┌──────────────────────────────────────────────────────────────┐\n# │  resource: aws_alb                                             │\n# └──────────────────────────────────────────────────────────────┘\nresource \"aws_alb\" \"this\" {\n\n  internal           = false  # bool | optional+computed\n  load_balancer_type = \"\"     # string | optional\n  name               = \"\"     # string | optional+computed\n  security_groups    = []     # set(string) | optional+computed\n  subnets            = []     # set(string) | optional+computed\n  tags               = {}     # map(string) | optional\n\n}\n\n",
          "config": {
            "attributes": {
              "name": "lurastack-web-alb",
              "internal": false,
              "load_balancer_type": "application",
              "subnets": "[aws_subnet.public_a.id, aws_subnet.public_b.id]",
              "security_groups": "[aws_security_group.alb.id]",
              "tags": "{ Name = \"lurastack-web-alb\" }"
            },
            "blocks": {}
          },
          "ui": {
            "x": 0,
