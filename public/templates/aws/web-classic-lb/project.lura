      "codeFiles": [
        {
          "id": "a1b2c3d4-0001-4000-8000-000000000001",
          "name": "user_data.sh",
          "content": "#!/bin/bash\nset -uo pipefail\n\n# Install nginx (Amazon Linux 2023 uses dnf; Amazon Linux 2 uses amazon-linux-extras + yum)\nif command -v dnf >/dev/null 2>&1; then\n  dnf install -y nginx\nelse\n  amazon-linux-extras enable nginx1 || true\n  yum clean metadata || true\n  yum install -y nginx\nfi\n\n# Fetch this instance's identity via IMDSv2 so every instance renders a\n# distinct page — refreshing through the ALB visibly lands on a different one.\nTOKEN=$(curl -s -X PUT \"http://169.254.169.254/latest/api/token\" -H \"X-aws-ec2-metadata-token-ttl-seconds: 300\")\nIID=$(curl -s -H \"X-aws-ec2-metadata-token: $TOKEN\" http://169.254.169.254/latest/meta-data/instance-id)\nAZ=$(curl -s -H \"X-aws-ec2-metadata-token: $TOKEN\" http://169.254.169.254/latest/meta-data/placement/availability-zone)\n\n# Derive a stable accent colour from the instance id so each box looks different.\nHEX=$(echo -n \"$IID\" | md5sum | cut -c1-6)\n\ncat > /usr/share/nginx/html/index.html <<HTML\n<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <title>LuraStack — $IID</title>\n    <style>\n      body { font-family: system-ui, sans-serif; display: grid; place-items: center; height: 100vh; margin: 0; background: #0f172a; color: #e2e8f0; }\n      .card { text-align: center; padding: 2rem 3rem; border: 4px solid #$HEX; border-radius: 12px; background: #1e293b; }\n      h1 { margin: 0 0 .5rem; color: #$HEX; }\n      code { color: #38bdf8; }\n    </style>\n  </head>\n  <body>\n    <div class=\"card\">\n      <h1>Instance $IID</h1>\n      <p>Availability zone: <code>$AZ</code></p>\n      <p>Refresh the page — the ALB may route you to a different instance.</p>\n      <p>Served by <strong>LuraStack</strong> ALB + Auto Scaling Group.</p>\n    </div>\n  </body>\n</html>\nHTML\n\nsystemctl enable nginx\nsystemctl restart nginx\n"
        },
        {
          "id": "a1b2c3d4-0002-4000-8000-000000000002",
          "name": "output.tf",
          "content": "output \"alb_dns_name\" {\n  description = \"Public DNS name of the Application Load Balancer\"\n  value       = aws_alb.main.dns_name\n}\n\noutput \"url\" {\n  description = \"Open this URL and refresh repeatedly to hit different instances\"\n  value       = \"http://${aws_alb.main.dns_name}\"\n}\n"
        }
      ]
    }
  ]
}
