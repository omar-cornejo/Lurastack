          "kind": "resource",
          "type": "aws_security_group",
          "name": "alb",
          "schemaId": "aws_security_group",
          "origin": "imported-file",
          "hclTemplate": "# ┌──────────────────────────────────────────────────────────────┐\n# │  resource: aws_security_group                                  │\n# └──────────────────────────────────────────────────────────────┘\nresource \"aws_security_group\" \"this\" {\n\n  description = \"\"     # string | optional\n  egress      = []     # set(object) | optional+computed\n  ingress     = []     # set(object) | optional+computed\n  name        = \"\"     # string | optional+computed\n  tags        = {}     # map(string) | optional\n  vpc_id      = \"\"     # string | optional+computed\n\n}\n\n",
          "config": {
            "attributes": {
              "name": "lurastack-web-alb-sg",
              "description": "Allow HTTP (80) from the internet to the ALB",
              "vpc_id": "aws_vpc.main.id",
              "ingress": "[{ description = \"HTTP from internet\", from_port = 80, to_port = 80, protocol = \"tcp\", cidr_blocks = [\"0.0.0.0/0\"], ipv6_cidr_blocks = [], prefix_list_ids = [], security_groups = [], self = false }]",
              "egress": "[{ description = \"All outbound\", from_port = 0, to_port = 0, protocol = \"-1\", cidr_blocks = [\"0.0.0.0/0\"], ipv6_cidr_blocks = [], prefix_list_ids = [], security_groups = [], self = false }]",
              "tags": "{ Name = \"lurastack-web-alb-sg\" }"
            },
            "blocks": {}
          },
          "ui": {
            "x": 0,
            "y": 400,
            "icon": "/icons/aws_security_group.svg"
          }
        },
