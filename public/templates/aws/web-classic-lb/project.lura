          "hclTemplate": "# ┌──────────────────────────────────────────────────────────────┐\n# │  resource: aws_autoscaling_group                               │\n# └──────────────────────────────────────────────────────────────┘\nresource \"aws_autoscaling_group\" \"this\" {\n\n  max_size                  = 0      # number | required\n  min_size                  = 0      # number | required\n  desired_capacity          = 0      # number | optional+computed\n  health_check_type         = \"\"     # string | optional+computed\n  health_check_grace_period = 0      # number | optional\n  name                      = \"\"     # string | optional+computed\n  target_group_arns         = []     # set(string) | optional+computed\n  vpc_zone_identifier       = []     # set(string) | optional+computed\n\n  launch_template { # list [0..1]\n    id      = \"\"     # string | optional+computed\n    version = \"\"     # string | optional+computed\n\n  }\n\n  tag { # set\n    key                 = \"\"     # string | required\n    propagate_at_launch = false  # bool | required\n    value               = \"\"     # string | required\n\n  }\n\n}\n\n",
          "config": {
            "attributes": {
              "name": "lurastack-web-asg",
              "min_size": 3,
              "max_size": 4,
              "desired_capacity": 3,
              "health_check_type": "ELB",
              "health_check_grace_period": 90,
              "vpc_zone_identifier": "[aws_subnet.public_a.id, aws_subnet.public_b.id]",
              "target_group_arns": "[aws_alb_target_group.app.arn]",
              "launch_template": [
                {
                  "id": "aws_launch_template.app.id",
                  "version": "$Latest"
                }
              ],
              "tag": [
                {
                  "key": "Name",
                  "value": "lurastack-web-app",
                  "propagate_at_launch": true
                }
              ]
            },
            "blocks": {}
          },
          "ui": {
            "x": 1120,
            "y": 600,
            "icon": "/icons/aws_autoscaling_group.svg"
          }
        }
