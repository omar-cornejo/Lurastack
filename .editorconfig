# EditorConfig — https://editorconfig.org
# Keeps indentation and line endings consistent across editors and contributors.
# These settings mirror the existing style in the codebase; they don't reformat it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Rust uses 4-space indentation (rustfmt default).
[*.rs]
indent_size = 4

# Go-style / Makefile-style tabs where required.
[Makefile]
indent_style = tab

# CSS in this project is authored with tabs.
[*.css]
indent_style = tab

# Markdown: trailing whitespace can be a hard line break, so don't trim it.
[*.md]
trim_trailing_whitespace = false

# Don't impose our style on vendored or generated lock/data files.
[{package-lock.json,Cargo.lock}]
indent_style = unset
indent_size = unset
insert_final_newline = unset
